<file path="pyproject.toml">
[build-system]
requires = ["setuptools>=64"]
build-backend = "setuptools.build_meta"

[project]
name = "gitbook-downloader"
version = "11.1.0"
description = "DocHarvest — Turn any documentation site into LLM-ready Markdown, vector RAG JSONL, llms.txt, and styled offline PDFs. Zero-config CLI, React desktop GUI & FastMCP server."
readme = "README.md"
license = {text = "MIT"}
authors = [
    {name = "Rohan Shetty", email = "shettyrohan2@gmail.com"},
]
keywords = ["docharvest", "gitbook", "documentation", "markdown", "downloader", "ai", "rag", "llms-txt", "mcp-server", "vector-db", "docusaurus", "readthedocs", "mintlify", "offline-docs", "pdf-generator", "nextra", "vitepress", "mkdocs", "readme-io"]
classifiers = [
    "Development Status :: 5 - Production/Stable",
    "Environment :: Console",
    "Intended Audience :: Developers",
    "License :: OSI Approved :: MIT License",
    "Operating System :: OS Independent",
    "Programming Language :: Python :: 3.10",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
    "Topic :: Internet :: WWW/HTTP",
    "Topic :: Software Development :: Documentation",
    "Topic :: Text Processing :: Markup",
    "Topic :: Utilities",
]
requires-python = ">=3.10"
dependencies = [
    "requests>=2.28.0",
    "beautifulsoup4>=4.11.0",
    "markdownify>=0.11.0",
    "lxml>=4.9.0",
    "mcp>=1.2.0",
    "textual>=0.60",
    "pyperclip>=1.8.0",
    "pywebview>=6.2.1",
    "fpdf2>=2.8.8",
]

[project.optional-dependencies]
# The `mcp` extra is a backward-compat no-op kept so existing
# `pip install "gitbook-downloader[mcp]"` instructions keep resolving;
# the SDK ships as a base dependency because `uvx gitbook-downloader mcp`
# installs no extras.
mcp = ["mcp>=1.2.0"]
render = ["playwright>=1.40.0"]
js = ["playwright>=1.40.0"]
dev = [
    "pytest>=8.0",
    "pytest-timeout>=2.3",
    "pytest-asyncio>=0.23",
    "pytest-cov>=4.0",
]

[project.scripts]
docharvest = "gitbook_downloader.cli:main"
gitbook-downloader = "gitbook_downloader.cli:main"
gitbook-dl = "gitbook_downloader.cli:main"

[project.urls]
Homepage = "https://github.com/RohannShetty/gitbook-downloader"
Repository = "https://github.com/RohannShetty/gitbook-downloader"
Issues = "https://github.com/RohannShetty/gitbook-downloader/issues"
Changelog = "https://github.com/RohannShetty/gitbook-downloader/blob/main/CHANGELOG.md"

[tool.setuptools.packages.find]
where = ["src"]

# Non-Python files that must ship for the installed app to work. Declared
# explicitly per directory because setuptools does not include data files by
# default, and a missing entry fails only at runtime for pip/uvx users:
#   - gui/web/**    the prebuilt desktop UI (`docharvest gui`)
#   - tui/*.tcss    the Textual stylesheet (`docharvest tui`, CSS_PATH)
#   - skills/**     bundled agent skills (`docharvest skill install`)
# tests/test_packaging.py asserts every data file in the source tree is covered.
[tool.setuptools.package-data]
gitbook_downloader = [
    "py.typed",
    "skills/*/SKILL.md",
    "gui/web/*.html",
    "gui/web/assets/*",
    "tui/*.tcss",
]

[dependency-groups]
dev = [
    "pyinstaller>=6.22.2",
    "pyinstaller-hooks-contrib>=2026.6",
    "pytest>=9.1.1",
    "pytest-asyncio>=1.4.0",
    "pytest-timeout>=2.4.0",
]

[tool.pytest.ini_options]
tmp_path_retention_policy = "none"
tmp_path_retention_count = 0
</file>

