{
  "$comment": "Canonical brand values for DocHarvest. This file is the single source of truth: scripts/sync-brand-tokens.mjs generates docs/app/brand-tokens.css (website) and frontend/src/styles/brand-tokens.css (desktop GUI) from it, and tests/test_brand_tokens.py fails if either generated file drifts. Change a value here, run the generator, and both surfaces move together.",
  "version": "11.2.0",
  "radius": "0px",
  "fonts": {
    "sans": ["Archivo", "ui-sans-serif", "system-ui", "sans-serif"],
    "mono": [
      "Geist Mono",
      "ui-monospace",
      "SFMono-Regular",
      "Roboto Mono",
      "Menlo",
      "Monaco",
      "Consolas",
      "monospace"
    ]
  },
  "primitives": {
    "dark": {
      "bond": "#09090B",
      "bond-2": "#101013",
      "bond-3": "#18181B",
      "rule": "#27272A",
      "rule-strong": "#3F3F46",
      "rule-subtle": "#1F1F23",
      "ink": "#F4F4F5",
      "ink-2": "#A1A1AA",
      "ink-3": "#8A8A93",
      "match": "#F59E0B",
      "match-deep": "#D97706",
      "match-subtle": "rgba(245, 158, 11, 0.08)",
      "alert": "#EF4444",
      "ok": "#34D399",
      "paper": "#FAFAFA"
    },
    "light": {
      "bond": "#FBFBFA",
      "bond-2": "#F4F4F5",
      "bond-3": "#ECECEF",
      "rule": "#E4E4E7",
      "rule-strong": "#A1A1AA",
      "rule-subtle": "#EDEDF0",
      "ink": "#18181B",
      "ink-2": "#52525B",
      "ink-3": "#6B6B74",
      "match": "#B45309",
      "match-deep": "#92400E",
      "match-subtle": "rgba(180, 83, 9, 0.06)",
      "alert": "#B91C1C",
      "ok": "#047857",
      "paper": "#FAFAFA"
    }
  },
  "shadcn": {
    "$comment": "Desktop-GUI semantic layer. Every entry maps a shadcn/ui CSS variable name to either a primitive (resolved per mode) or a literal hex. Components only ever read these semantic names, so the palette can move without touching a component.",
    "background": "bond",
    "foreground": "ink",
    "card": "bond-2",
    "card-foreground": "ink",
    "popover": "bond-2",
    "popover-foreground": "ink",
    "primary": "match",
    "primary-foreground": { "dark": "#09090B", "light": "#FAFAFA" },
    "secondary": "bond-3",
    "secondary-foreground": "ink",
    "muted": "bond-2",
    "muted-foreground": "ink-2",
    "accent": "bond-3",
    "accent-foreground": "ink",
    "destructive": "alert",
    "destructive-foreground": { "dark": "#FAFAFA", "light": "#FAFAFA" },
    "success": "ok",
    "success-foreground": { "dark": "#09090B", "light": "#FAFAFA" },
    "info": "match",
    "info-foreground": { "dark": "#09090B", "light": "#FAFAFA" },
    "border": "rule",
    "input": "rule",
    "ring": "match"
  }
}
